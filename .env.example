# =============================================================================
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. NEVER commit real credentials.
# =============================================================================

# --- DATABASE (Neon Postgres) ------------------------------------------------
# Two endpoints for the SAME database, used for different jobs.
# DATABASE_URL: POOLED endpoint (host contains "-pooler"). Used by the app at
#   runtime. Serverless opens many short-lived connections against a hard
#   Postgres cap; PgBouncer multiplexes them.
# DIRECT_URL: DIRECT endpoint (no "-pooler"). Used by the Prisma CLI for
#   migrations, which need session features a transaction pooler cannot provide.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- AUTH (Auth.js v5) -------------------------------------------------------
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
# Signs the JWT session cookie. Changing it logs everyone out.
AUTH_SECRET=""
# Canonical app URL. http://localhost:3000 in dev, the deployed URL in prod.
AUTH_URL="http://localhost:3000"

# --- GOOGLE CALENDAR (OAuth 2.0) ---------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials.
# This is a SEPARATE concern from login: signing in and authorising calendar
# access are different grants. See README for the full setup walkthrough.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match a redirect URI registered in the Google Cloud Console EXACTLY.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# --- LLM (Google Gemini) -----------------------------------------------------
# Server-only. If this ever gains a NEXT_PUBLIC_ prefix, the key is public.
GEMINI_API_KEY=""
# Optional: override the default model, e.g. when Google retires one.
GEMINI_MODEL="gemini-3.6-flash"
# Per-call ceiling for LLM requests. All calls run outside the request path.
LLM_TIMEOUT_MS="30000"

# --- EMAIL (Nodemailer over Gmail SMTP) --------------------------------------
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your Google password.
# Requires 2-Step Verification enabled on the account.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM="Healthcare Portal <you@gmail.com>"

# --- BACKGROUND JOBS ---------------------------------------------------------
# Shared secret required by /api/cron/*. Without it the endpoints are an open
# relay anyone can trigger to send mail. Generate: openssl rand -hex 32
CRON_SECRET=""

# --- PUBLIC (exposed to the browser — safe values ONLY) ----------------------
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle and is
# readable by anyone via View Source. Never put a credential here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
