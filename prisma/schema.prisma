// Prisma schema — the single source of truth for the database shape.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: no `url` here. In Prisma 7 the connection string lives in
  // prisma.config.ts, which reads process.env.DATABASE_URL via dotenv.
}

/// Every human who can log in — patients, doctors and admins share one table.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  /// Only present when role = DOCTOR. Optional on this side, so a patient row
  /// simply has none -- the absence itself signals "not a doctor".
  doctorProfile DoctorProfile?
  appointments  Appointment[]
  slotHolds     SlotHold[]
  notifications Notification[]

  @@index([role])
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

/// Doctor-specific fields. Separate from User so the User table stays about
/// identity and login, and so a missing profile means "not a doctor".
model DoctorProfile {
  id String @id @default(cuid())

  /// @unique on the foreign key is what makes this ONE-TO-ONE. Without it,
  /// one user could own several profiles.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialisation  String
  /// Appointment length in minutes. Drives slot generation in Step 12.
  slotDurationMin Int     @default(30)
  bio             String?

  /// IANA timezone of the clinic this doctor works at, e.g. "Asia/Kolkata".
  /// WorkingHour stores wall-clock minutes; Appointment stores UTC instants.
  /// This field is the ONLY thing that can convert between the two. Without
  /// it, "09:00" is not a real point in time.
  timezone        String  @default("Asia/Kolkata")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  workingHours WorkingHour[]
  leaveDays    LeaveDay[]
  appointments Appointment[]
  slotHolds    SlotHold[]

  /// Patients search by specialisation, so it earns an index.
  @@index([specialisation])
}

/// One row per continuous block a doctor works on a given weekday.
/// NOT unique on (doctorId, dayOfWeek): split shifts are normal, e.g. a doctor
/// working 09:00-13:00 and again 17:00-20:00 on a Tuesday is two rows.
model WorkingHour {
  id String @id @default(cuid())

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// 0 = Sunday ... 6 = Saturday, matching JavaScript's Date.getDay().
  dayOfWeek Int

  /// Minutes since midnight in the CLINIC'S local time. 540 = 09:00.
  ///
  /// WHY NOT DateTime? A working hour is not an instant -- it is a recurring
  /// wall-clock time. "The clinic opens at 9" is true every week regardless of
  /// date or daylight saving. Storing it as a DateTime would force an
  /// arbitrary date onto it and invite timezone conversion that must not
  /// happen. Integers also make slot arithmetic trivial: start, start+duration.
  startMinute Int
  endMinute   Int

  @@index([doctorId, dayOfWeek])
}

/// A single date a doctor is unavailable. Step 31 checks these before booking
/// and detects conflicts with appointments already made.
model LeaveDay {
  id String @id @default(cuid())

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// @db.Date stores a calendar date with NO time and NO timezone. Using a
  /// full DateTime here would make "on leave 12 March" mean different things
  /// to servers in different zones.
  date   DateTime @db.Date
  reason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// A doctor cannot be on leave twice for the same date. The database
  /// enforces it, so a double-submit cannot create duplicates.
  @@unique([doctorId, date])
}

/// A booked appointment. NOTE: at Step 14 this table has NO protection against
/// two rows sharing (doctorId, startAt). That gap is deliberate and is fixed by
/// a partial unique index in Step 15.
model Appointment {
  id String @id @default(cuid())

  doctorId String
  /// Restrict, NOT Cascade. Deleting a doctor must never delete appointments --
  /// they are medical records and outlive the doctor's employment. Postgres
  /// refuses the delete instead, and the service turns that into a 409.
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  patientId String
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// UTC instant. The clinic's wall-clock time lives in WorkingHour; this is
  /// the real point in time that slot resolved to.
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  status       AppointmentStatus @default(CONFIRMED)
  cancelReason CancelReason?
  cancelledAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  symptomForm      SymptomForm?
  preVisitSummary  PreVisitSummary?
  visitNote        VisitNote?
  prescription     Prescription?
  postVisitSummary PostVisitSummary?

  /// Availability lookups: "what does this doctor have booked on this day?"
  @@index([doctorId, startAt])
  /// The patient's own list of appointments.
  @@index([patientId, startAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum CancelReason {
  PATIENT_REQUEST
  DOCTOR_LEAVE
  ADMIN
  HOLD_EXPIRED
}

/// A short-lived reservation taken when a patient selects a slot, so they can
/// fill in the symptom form without losing it. Converted to an Appointment on
/// confirm (Step 18), or left to expire.
///
/// CONTRAST WITH Appointment: that table keeps cancelled rows forever (medical
/// records), which is why its unique index is PARTIAL. A hold is ephemeral --
/// it is deleted, never archived -- so a plain unique constraint is right here.
model SlotHold {
  id String @id @default(cuid())

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  patientId String
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// When this reservation lapses. A row whose expiresAt has passed is dead
  /// but still present, and still occupies the unique key -- so it MUST be
  /// deleted before that slot can be held again. Cleaned lazily on read and by
  /// the cron job in Step 37.
  expiresAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Exclusivity: one live hold per doctor per start time. This is what makes
  /// two patients unable to hold the same slot.
  @@unique([doctorId, startAt])
  /// The cleanup job sweeps by expiry.
  @@index([expiresAt])
  /// "Does this patient already hold something?"
  @@index([patientId])
}

/// OUTBOX. The business transaction writes a row here instead of sending
/// anything. A cron worker (Step 25) picks up PENDING rows and delivers them.
/// This is what keeps a mail server outage from rolling back a real booking.
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel @default(EMAIL)
  /// Everything the worker needs to render the message, captured at write
  /// time. Stored rather than re-queried so a later edit cannot change the
  /// content of an email that was already queued.
  payload Json

  status      NotificationStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  /// Exponential backoff target. The worker only picks rows due now.
  nextRetryAt DateTime? @db.Timestamptz(3)
  sentAt      DateTime? @db.Timestamptz(3)

  /// Makes retries safe: the same logical event can never be queued twice.
  idempotencyKey String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// The worker's query: pending and due.
  @@index([status, nextRetryAt])
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_CANCELLED
  APPOINTMENT_REMINDER
  MEDICATION_REMINDER
  DOCTOR_LEAVE_CANCELLATION
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// What the patient reported before the visit. Created in the same transaction
/// as the Appointment, so there is never an appointment without symptoms and
/// never an orphan form.
model SymptomForm {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// The patient's own words. Kept verbatim -- this is what the doctor falls
  /// back to reading if the LLM summary fails (Step 22).
  rawText      String
  durationDays Int
  severity     Int
  /// Free text, comma separated as typed. Not modelled further because
  /// nothing queries it; it is context for a human and for the prompt.
  existingConditions String?
  currentMedications String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// LLM-generated triage summary for the doctor.
///
/// THREE STATES, because generation is unreliable by nature:
///   PENDING — row exists, generation not finished (or never started)
///   READY   — validated output stored
///   FAILED  — gave up; the doctor sees the raw symptom text instead
///
/// The row is created PENDING inside the booking transaction, so a summary is
/// never silently missing: a doctor can always tell "not ready yet" from
/// "nobody ever tried".
model PreVisitSummary {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  status SummaryStatus @default(PENDING)

  urgency            Urgency?
  chiefComplaint     String?
  summary            String?
  suggestedQuestions String[]

  /// Kept for debugging: when validation fails you need to see what the model
  /// actually said, not just that it was rejected.
  rawModelOutput String?
  promptVersion  String?
  lastError      String?
  attempts       Int      @default(0)
  generatedAt    DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum SummaryStatus {
  PENDING
  READY
  FAILED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

/// The doctor's clinical record of the consultation.
model VisitNote {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  clinicalNotes String
  diagnosis     String?
  followUpDays  Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Prescription {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  notes String?
  items PrescriptionItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// STRUCTURED, not a free-text box. Reminders must be COMPUTED from frequency
/// and duration, and you cannot compute a schedule from "take twice a day for
/// a week" written in prose.
model PrescriptionItem {
  id String @id @default(cuid())

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  drugName     String
  dose         String
  frequency    Frequency
  durationDays Int
  instructions String?

  reminders MedicationReminder[]
}

enum Frequency {
  ONCE_DAILY
  TWICE_DAILY
  THRICE_DAILY
  FOUR_TIMES_DAILY
  EVERY_OTHER_DAY
  WEEKLY
  AS_NEEDED
}

/// One materialised row per dose. Rows rather than on-the-fly computation so
/// each dose can be individually queued, retried, cancelled and audited.
model MedicationReminder {
  id String @id @default(cuid())

  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)

  scheduledAt DateTime           @db.Timestamptz(3)
  status      ReminderStatus     @default(PENDING)
  sentAt      DateTime?          @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// The dispatcher's query: due and not yet handled.
  @@index([status, scheduledAt])
  /// Stops a re-run of schedule generation duplicating a dose.
  @@unique([prescriptionItemId, scheduledAt])
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

/// Patient-friendly summary of the visit, same three-state pattern as the
/// pre-visit summary.
model PostVisitSummary {
  id String @id @default(cuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  status SummaryStatus @default(PENDING)

  patientFriendlyText String?
  medicationSchedule  String?
  followUpSteps       String[]

  rawModelOutput String?
  promptVersion  String?
  lastError      String?
  attempts       Int      @default(0)
  generatedAt    DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
